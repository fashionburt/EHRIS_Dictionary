@model dynamic
@{
    ViewData["Title"] = "操作紀錄查詢";
    Layout = "_LayoutSub";
}

<link href="/css/DataTableStyles.css" rel="stylesheet" />
<link href="/css/Button.css" rel="stylesheet" />

<section class="content">
    <div class="container-fluid">
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="card-title fw-bold">
                        <i class="fa-solid fa-clock-rotate-left me-2"></i>操作紀錄查詢
                    </h5>

                    <div class="d-flex gap-2">
                        @if (!string.IsNullOrEmpty(ViewBag.InitialPkName))
                        {
                            <button type="button" class="btn btn-secondary btn-sm"
                                    onclick="loadMvc('/DIC1999R02/DIC1999R02?dbKey=@ViewBag.InitialDbKey&tableName=@ViewBag.InitialTableName&sid=' + $('#selSid').val())">
                                <i class="fa-solid fa-arrow-rotate-left me-1"></i>返回資料欄列表
                            </button>
                        }
                        else if (!string.IsNullOrEmpty(ViewBag.InitialTableName))
                        {
                            <button type="button" class="btn btn-secondary btn-sm"
                                    onclick="loadMvc('/DIC1999R01/DIC1999R01?dbKey=@ViewBag.InitialDbKey&sid=' + $('#selSid').val())">
                                <i class="fa-solid fa-arrow-rotate-left me-1"></i>返回資料表列表
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-secondary btn-sm"
                                    onclick="loadMvc('/DIC1999/DIC1999?sid=' + $('#selSid').val())">
                                <i class="fa-solid fa-arrow-rotate-left me-1"></i>返回資料庫列表
                            </button>
                        }
                    </div>
                </div>
                <hr />
                <form id="searchForm" class="row g-3">
                    @Html.AntiForgeryToken()
                    <div class="col-md-1">
                        <label class="form-label fw-bold">伺服器</label>
                        <select id="selSid" class="form-select form-select-sm">
                            <option value="111" @(ViewBag.Sid == "111" ? "selected" : "")>111</option>
                            <option value="112" @(ViewBag.Sid == "112" ? "selected" : "")>112</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold">資料庫</label>
                        <select id="selDbKey" class="form-select form-select-sm">
                            <option value="">全部</option>
                            @if (ViewBag.DbKeys != null)
                            {
                                foreach (var item in (List<string>)ViewBag.DbKeys)
                                {
                                    <option value="@item" @(ViewBag.InitialDbKey == item ? "selected" : "")>@item</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold">資料表</label>
                        <input type="hidden" id="initTableName" value="@ViewBag.InitialTableName" />
                        <select id="selTableName" class="form-select form-select-sm" disabled>
                            <option value="">全部</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold">欄位</label>
                        <input type="hidden" id="initPkName" value="@ViewBag.InitialPkName" />
                        <select id="selPkName" class="form-select form-select-sm" disabled>
                            <option value="">全部</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold">操作行為</label>
                        <select id="selState" class="form-select form-select-sm">
                            <option value="">全部</option>
                            <option value="10">新增</option>
                            <option value="11">申請</option>
                            <option value="20">更新</option>
                            <option value="21">密碼變更</option>
                            <option value="30">刪除</option>
                            <option value="40">查詢</option>
                            <option value="50">啟用</option>
                            <option value="51">關閉</option>
                            <option value="60">操作訊息</option>
                            <option value="70">登入</option>
                            <option value="71">登出</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">關鍵字</label>
                        <div class="input-group input-group-sm">
                            <input type="text" id="txtKeyword" class="form-control" placeholder="搜尋紀錄內容..." />
                            <button type="button" class="btn btn-primary" id="btnSearch">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table id="logTable" class="table table-bordered table-hover w-100 table-sm">
                        <thead class="table-light text-center">
                            <tr>
                                <th class="dt-col-mid">資料庫</th>
                                <th class="dt-col-mid">資料表</th>
                                <th class="dt-col-mid">欄位</th>
                                <th class="dt-col-min">操作行為</th>
                                <th class="dt-col-max">紀錄內容</th>
                                <th class="dt-col-time">紀錄時間</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    window.permissionAction = {
        getData: '@Url.Action("GetData", "DIC1997")',
        getTables: '@Url.Action("GetTableNames", "DIC1997")',
        getPks: '@Url.Action("GetPkNames", "DIC1997")',
        sid: '@ViewBag.Sid',
        dataTableLangUrl: '@Url.Content("~/lib/datatables.net/plug-ins/i18n/zh-HANT.json")',
        tokenName: '__RequestVerificationToken',
        tokenValue: $('input[name="__RequestVerificationToken"]').val()
    };
</script>