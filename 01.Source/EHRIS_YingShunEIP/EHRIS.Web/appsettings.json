{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // 主應用程式功能
    "DefaultConnection": "Server=192.168.11.111;Database=YingShunEIP2;User ID=sa;Password=$$$yshun168;TrustServerCertificate=True;",
    // 日誌專用資料庫
    "LogConnection": "Server=192.168.11.111;Database=EHRISHistory;User ID=sa;Password=$$$yshun168;TrustServerCertificate=True;",
    // 資料字典
    "TargetServerTemplate": "Server={0};User ID=sa;Password=$$$yshun168;TrustServerCertificate=True;Persist Security Info=True;"
  },
  "DetailedErrors": true,
  "IdleSettings": {
    "IdleTimeoutSeconds": 1800, // 閒置 30 分鐘, 單位:秒
    "WarningSeconds": 30 // 倒數 30 秒警告
  },

  "Session": {
    "TimeoutMinutes": 30 // 跟 IdleTimeoutSeconds 一致
  },

  "UploadSettings": {
    "UploadPath": "C:\\UploadFiles\\EHRIS\\",
    "PeoplePhotoPath": "C:\\UploadFiles\\EHRIS\\PeoplePhoto\\"
  },
  "AutoLogin": {
    "AdminAccount": "admin",
    "AdminPassword": "abc12345",
    "PartnerAccount": "Test2025",
    "PartnerPassword": "Aa123456!@"
  }
}
