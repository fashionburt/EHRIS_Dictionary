<div class="modal modal-morandi" id="deptModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">單位參數設定</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">參數變數</label>
                        <input type="text" class="form-control" id="dept_arg_variable" readonly>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">參數說明</label>
                        <input type="text" class="form-control" id="dept_arg_describe" readonly>
                    </div>
                </div>
                <div class="d-flex justify-content-end mb-2">
                    <button type="button" class="btn btn-success btn-sm" id="btnAddDeptRow">
                        新增單位
                    </button>
                </div>
                <div class="table-responsive">
                    <table class="table table-bordered table-striped" id="deptGridTable">
                        <thead>
                            <tr>
                                <th style="width: 35%;">單位名稱</th>
                                <th style="width: 20%;">系統參數值</th>
                                <th style="width: 25%;">單位參數值</th>
                                <th style="width: 10%;" class="text-center">排程</th>
                                <th style="width: 10%;" class="text-center">刪除</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary btn-sm" id="btnSaveAllDept">儲存</button>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">取消</button>
            </div>
        </div>
    </div>
</div>

<div class="modal modal-morandi" id="schedModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">時間排程設定 (<span id="sched_dept_name"></span>)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex justify-content-end mb-2">
                    <button type="button" class="btn btn-success btn-sm" id="btnAddSchedRow">
                        新增排程
                    </button>
                </div>
                <div class="table-responsive">
                    <table class="table table-bordered table-striped" id="schedGridTable" style="table-layout: fixed;">
                        <thead>
                            <tr>
                                <th style="width: 45%;">開始時間</th>
                                <th style="width: 45%;">結束時間</th>
                                <th style="width: 10%;" class="text-center">刪除</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary btn-sm" id="btnSaveAllSched">儲存</button>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">取消</button>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_DepartmentTreeModal", (object)Model)
<input type="hidden" id="selectedDepartments">
<div id="selectedDepartmentsTags" style="display:none;"></div>