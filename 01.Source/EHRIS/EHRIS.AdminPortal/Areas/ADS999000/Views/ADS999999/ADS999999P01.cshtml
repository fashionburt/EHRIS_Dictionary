@using System.Text.Json
@model EHRIS.Core.Models.AdminPortal.LevelDataViewModel
<div class="admin-workspace modal-admin">
    <input type="hidden" id="originDataJson" value='@JsonSerializer.Serialize(Model.Levels)' />

    <div class="alert alert-info py-2" style="background-color: #E6D5C6; border-color: #D6C2AF; color: #5C4033;">
        <b>操作說明：</b> 操作會即時反映在下方列表，完成變更時<b>必須按下右下角「儲存」。
    </div>

    <div class="mb-3 text-end">
        <button type="button" class="btn btn-sm btn-primary" id="btnAddLevelRow">
            新增權限層級
        </button>
    </div>

    <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
        <table class="table table-bordered table-striped align-middle">
            <thead class="table-light sticky-top">
                <tr>
                    <th width=15% class="text-center">編號</th>
                    <th width=30% class="text-center">層級名稱</th>
                    <th width=20% class="text-center">權限等級</th>
                    <th width=15% class="text-center">狀態</th>
                    <th width=10% class="text-center">修改</th>
                    <th width=10% class="text-center">刪除</th>
                </tr>
            </thead>
            <tbody id="dynamicLevelBody">
            </tbody>
        </table>
    </div>
</div>