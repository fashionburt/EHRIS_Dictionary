@using EHRIS.Core.Models.Common
@model LoginViewModel
@addTagHelper *, DNTCaptcha.Core

@{
    ViewData["Title"] = "登入";
    Layout = null;
    // ── 品牌文字（由 Controller 端動態傳入，目前暫時寫死）──
    string brandLine1 = @AppConfig.syi_title;
    string brandLine2 = @AppConfig.syi_subtitle;
}

<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>登入 | @AppConfig.syi_title</title>

    <link rel="stylesheet" href="~/lib/admin-lte/css/adminlte.min.css">
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css">
    <link rel="stylesheet" href="~/lib/sweetalert2/sweetalert2.min.css" />
    <link rel="stylesheet" href="~/css/AdminButton.css">


    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js" asp-append-version="true"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js" asp-append-version="true"></script>
    <script src="~/lib/jquery-ajax-unobtrusive-main/jquery.unobtrusive-ajax.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/admin-lte/js/adminlte.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/js/EHRISsite.js"></script>

    <style>
        /* ── 全域重置 ── */
        *, *::before, *::after {
        box-sizing: border-box;
        }

        html, body {
        height: 100%;
        margin: 0;
        padding: 0;
        font-family: "Segoe UI", "Microsoft JhengHei", "Helvetica Neue", Arial, sans-serif;
        }

        /* ════════════════════════════════════════
        全頁容器（科技風底圖）
        ════════════════════════════════════════ */
        .login-wrapper {
        min-height: 100vh;
        position: relative;
        overflow: hidden;
        background: #071428;
        display: flex;
        align-items: center;
        justify-content: center;
        }

        /* 深度光暈（四角藍光）*/
        .login-wrapper::before {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse 55% 55% at 0% 0%, rgba(20,80,200,0.28) 0%, transparent 65%), radial-gradient(ellipse 45% 45% at 100% 0%, rgba(15,60,180,0.18) 0%, transparent 60%), radial-gradient(ellipse 50% 45% at 0% 100%, rgba(15,60,180,0.16) 0%, transparent 60%), radial-gradient(ellipse 55% 50% at 100% 100%, rgba(20,70,190,0.20) 0%, transparent 65%);
        z-index: 1;
        pointer-events: none;
        }

        /* 中央暗淡暈（增加景深感）*/
        .login-wrapper::after {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse 60% 60% at 50% 50%, rgba(5,20,60,0.35) 0%, transparent 70%);
        z-index: 1;
        pointer-events: none;
        }

        /* 粒子 Canvas */
        #tech-canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        }

        /* 掃描線 */
        .scan-line {
        position: absolute;
        left: 0;
        right: 0;
        height: 2px;
        background: linear-gradient(90deg, transparent 0%, rgba(80,150,255,0) 15%, rgba(80,150,255,0.30) 50%, rgba(80,150,255,0) 85%, transparent 100%);
        z-index: 2;
        animation: scanDown 5s linear infinite;
        pointer-events: none;
        }

        @@keyframes scanDown {
        0% {
        top: -2px;
        opacity: 0;
        }

        5% {
        opacity: 1;
        }

        95% {
        opacity: 1;
        }

        100% {
        top: 100%;
        opacity: 0;
        }
        }

        /* ════════════════════════════════════════
        右上角樣式切換器
        ════════════════════════════════════════ */
        .style-switcher {
        position: fixed;
        top: 1rem;
        right: 1.5rem;
        z-index: 200;
        }

        .style-btn {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        background: rgba(5,18,48,0.82);
        border: 1px solid rgba(60,130,230,0.40);
        color: rgba(180,210,255,0.92);
        border-radius: 8px;
        padding: 0.45rem 1rem;
        font-size: 0.83rem;
        cursor: pointer;
        backdrop-filter: blur(10px);
        transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
        letter-spacing: 0.03em;
        }

        .style-btn:hover {
        border-color: rgba(80,160,255,0.65);
        box-shadow: 0 0 14px rgba(60,130,230,0.28);
        background: rgba(5,22,58,0.90);
        }

        .style-btn .fa-palette {
        color: #5aa0f0;
        }

        .style-btn .fa-chevron-down {
        font-size: 0.7rem;
        transition: transform 0.2s;
        }

        .style-btn.open .fa-chevron-down {
        transform: rotate(180deg);
        }

        .style-menu {
        position: absolute;
        top: calc(100% + 6px);
        right: 0;
        background: rgba(4,16,44,0.94);
        border: 1px solid rgba(60,130,230,0.25);
        border-radius: 10px;
        list-style: none;
        padding: 0.4rem 0;
        min-width: 150px;
        backdrop-filter: blur(14px);
        box-shadow: 0 8px 28px rgba(0,0,0,0.5), 0 0 16px rgba(40,100,200,0.10);
        display: none;
        animation: menuFadeIn 0.15s ease both;
        }

        .style-menu.open {
        display: block;
        }

        @@keyframes menuFadeIn {
        from {
        opacity: 0;
        transform: translateY(-6px);
        }

        to {
        opacity: 1;
        transform: translateY(0);
        }
        }

        .style-menu-title {
        font-size: 0.72rem;
        color: rgba(80,150,230,0.6);
        padding: 0.35rem 1rem 0.2rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        border-bottom: 1px solid rgba(60,120,220,0.15);
        margin-bottom: 0.3rem;
        }

        .style-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        color: rgba(170,205,255,0.8);
        cursor: pointer;
        font-size: 0.84rem;
        transition: background 0.15s, color 0.15s;
        user-select: none;
        }

        .style-item:hover {
        background: rgba(60,130,230,0.12);
        color: #d0e8ff;
        }

        .style-item.active {
        color: #5aa0f0;
        }

        .style-item .style-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        flex-shrink: 0;
        }

        .style-item.active .style-dot {
        background: #5aa0f0;
        box-shadow: 0 0 6px #4a90e0;
        }

        .style-item:not(.active) .style-dot {
        background: rgba(160,200,255,0.25);
        }

        /* ════════════════════════════════════════
        主版面：雙欄（登入區 + 公告看板）
        ════════════════════════════════════════ */
        .login-area {
        position: relative;
        z-index: 3;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        gap: 1.75rem;
        padding: 2rem 1.5rem;
        width: 100%;
        max-width: 960px;
        }

        /* 左側登入欄 */
        .login-section {
        flex-shrink: 0;
        width: 420px;
        display: flex;
        flex-direction: column;
        align-items: center;
        }

        /* ── 品牌 Header（icon + 文字）── */
        .brand-header-row {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        padding-bottom: 0.8rem;
        border-bottom: 1px solid #e2eaf6;
        margin-bottom: 0.7rem;
        }

        .brand-icon-wrap {
        flex-shrink: 0;
        width: 68px;
        height: 68px;
        background: #eef2ff;
        border-radius: 10px;
        border: 1px solid #c8d4f0;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        }

        .brand-icon-img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        }

        .brand-text-block {
        flex: 1;
        text-align: center;
        }

        .brand-line1 {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1a2d56;
        letter-spacing: 0.06em;
        line-height: 1.35;
        }

        .brand-line2 {
        font-size: 1rem;
        font-weight: 600;
        color: #1a8fa0;
        letter-spacing: 0.15em;
        margin-top: 0.25rem;
        }

        /* ── 登入方式 Tabs ── */
        .login-tabs {
        display: flex;
        border: 1.5px solid #c8d4f0;
        border-radius: 8px;
        overflow: hidden;
        margin-bottom: 1.1rem;
        background: #f5f8ff;
        }

        .login-tab {
        flex: 1;
        padding: 0.5rem 0.2rem;
        text-align: center;
        font-size: 0.79rem;
        cursor: pointer;
        color: #2a4070;
        border-right: 1.5px solid #c8d4f0;
        transition: background 0.2s, color 0.2s;
        user-select: none;
        white-space: nowrap;
        }

        .login-tab:last-child {
        border-right: none;
        }

        .login-tab.active {
        background: #1a2d56;
        color: #fff;
        font-weight: 600;
        }

        .login-tab:not(.active):hover {
        background: #dde6f8;
        }

        /* ── 登入卡片外層（提供 drawer 定位錨點）── */
        .login-card-wrap {
        position: relative;
        width: 100%;
        }

        /* ── 公告 Tab 按鈕（右邊緣垂直）── */
        .ann-tab {
        position: absolute;
        right: -40px;
        top: 120px;
        width: 40px;
        background: #1a2d56;
        color: #fff;
        border: none;
        border-radius: 0 8px 8px 0;
        padding: 14px 0;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 7px;
        z-index: 15;
        box-shadow: 4px 2px 14px rgba(0,0,0,0.32);
        transition: background 0.2s, box-shadow 0.2s;
        }

        .ann-tab:hover {
        background: #2a4080;
        box-shadow: 4px 2px 20px rgba(0,0,0,0.42);
        }

        .ann-tab.is-open {
        opacity: 0;
        pointer-events: none;
        }

        .ann-tab .ann-tab-icon {
        font-size: 0.88rem;
        }

        .ann-tab .ann-tab-text {
        writing-mode: vertical-rl;
        font-size: 0.74rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        white-space: nowrap;
        }

        /* ── 公告抽屜面板 ── */
        .ann-drawer {
        position: absolute;
        left: 100%;
        top: 0;
        width: 320px;
        background: #fff;
        border-radius: 0 16px 16px 0;
        box-shadow: 8px 6px 28px rgba(0,0,0,0.32);
        overflow: hidden;
        transform: translateX(18px);
        opacity: 0;
        pointer-events: none;
        transition: transform 0.32s cubic-bezier(0.4,0,0.2,1), opacity 0.28s ease;
        z-index: 12;
        }

        .ann-drawer.open {
        transform: translateX(0);
        opacity: 1;
        pointer-events: auto;
        }

        /* Drawer：頁首 */
        .ann-dw-header {
        background: #1a2d56;
        color: #fff;
        padding: 0.72rem 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        }

        .ann-dw-title-label {
        flex: 1;
        }

        .ann-dw-toggle {
        font-size: 0.72rem;
        color: rgba(180,210,255,0.78);
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 3px;
        padding: 2px 7px;
        border-radius: 4px;
        white-space: nowrap;
        transition: background 0.15s;
        }

        .ann-dw-toggle:hover {
        background: rgba(255,255,255,0.12);
        }

        .ann-dw-close {
        background: none;
        border: none;
        color: rgba(180,210,255,0.65);
        cursor: pointer;
        font-size: 1rem;
        line-height: 1;
        padding: 0 0 0 4px;
        transition: color 0.15s;
        }

        .ann-dw-close:hover {
        color: #fff;
        }

        /* Drawer：表格 */
        .ann-dw-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.81rem;
        }

        .ann-dw-table thead th {
        padding: 0.45rem 0.8rem;
        color: #5a6a8a;
        font-size: 0.71rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        border-bottom: 1.5px solid #e2eaf6;
        background: #f4f7ff;
        }

        .ann-dw-table tbody tr {
        border-bottom: 1px solid #edf0f8;
        transition: background 0.12s;
        }

        .ann-dw-table tbody tr:hover {
        background: #f0f5ff;
        }

        .ann-dw-table tbody td {
        padding: 0.5rem 0.8rem;
        vertical-align: middle;
        }

        .ann-dw-row-urgent td {
        background: rgba(220,53,69,0.05);
        }

        .ann-dw-row-important td {
        background: rgba(253,126,20,0.05);
        }

        .ann-dw-cell-title {
        color: #1a2d56;
        cursor: pointer;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.4;
        }

        .ann-dw-cell-title:hover {
        color: #0f2560;
        text-decoration: underline;
        }

        .ann-dw-cell-date {
        color: #8a9ab8;
        font-size: 0.71rem;
        white-space: nowrap;
        text-align: right;
        }
        /* 抽屜徽章（實心色塊） */
        .ann-dw-badge {
        display: inline-block;
        padding: 0.13rem 0.42rem;
        border-radius: 4px;
        font-size: 0.68rem;
        font-weight: 700;
        white-space: nowrap;
        }



        .ann-dw-footer {
        padding: 0.48rem 0.9rem;
        font-size: 0.72rem;
        color: #8a9ab8;
        text-align: right;
        border-top: 1px solid #e8edf8;
        background: #f9fbff;
        }

        /* ── 登入卡片 ── */
        .login-card {
        width: 100%;
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 36px rgba(0,0,0,0.50), 0 0 0 1px rgba(50,120,220,0.18);
        animation: fadeUp 0.65s ease both;
        }

        /* ── 統一白色 Header（Logo + 標題融合）── */
        .login-card-header {
        overflow: hidden;
        }

        .card-header-unified {
        background: #fff;
        padding: 1.5rem 1.75rem 1.1rem;
        text-align: center;
        border-bottom: 1px solid #e2eaf6;
        }

        .card-logo-compact {
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 0.75rem;
        }

        .brand-logo-compact {
        width: 100%;
        max-width: 300px;
        max-height: 70px;
        object-fit: contain;
        display: block;
        }

        .card-login-title {
        font-size: 1.12rem;
        font-weight: 700;
        color: #1a2d56;
        margin: 0;
        letter-spacing: 0.02em;
        }

        /* ── 表單主體 ── */
        .login-card-body {
        padding: 1.5rem 1.75rem 1.1rem;
        }

        .alert-danger {
        font-size: 0.87rem;
        border-radius: 8px;
        padding: 0.65rem 1rem;
        margin-bottom: 1.1rem;
        }

        /* ── 簡潔輸入框（內嵌 icon）── */
        .simple-field {
        position: relative;
        margin-bottom: 0.85rem;
        display: flex;
        align-items: stretch;
        }

        .simple-field .field-icon {
        position: absolute;
        left: 13px;
        top: 50%;
        transform: translateY(-50%);
        color: #4a6ab0;
        font-size: 0.82rem;
        z-index: 2;
        pointer-events: none;
        }

        .simple-input {
        flex: 1;
        height: 42px;
        padding: 0 36px !important;
        border: 1.5px solid #c8d4f0 !important;
        border-radius: 8px !important;
        background: #f5f8ff !important;
        font-size: 0.9rem;
        color: #1a2d56;
        transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
        }

        .simple-input:focus {
        border-color: #2a5cc8 !important;
        box-shadow: 0 0 0 3px rgba(42,92,200,0.11) !important;
        background: #fff !important;
        outline: none;
        z-index: 1;
        }

        .simple-input::placeholder {
        color: #a0b0cc;
        }

        /* 密碼眼睛按鈕 */
        .simple-eye {
        position: absolute;
        right: 11px;
        top: 50%;
        transform: translateY(-50%);
        color: #4a6ab0;
        font-size: 0.85rem;
        z-index: 3;
        line-height: 1;
        }

        .simple-eye:hover {
        color: #1a3a7a;
        }

        /* 驗證碼：輸入框 + 圖片 + 刷新 */
        .captcha-wrap .simple-input {
        border-radius: 8px 0 0 8px !important;
        }

        .captcha-addon {
        display: flex;
        align-items: center;
        border: 1.5px solid #c8d4f0;
        border-left: none;
        border-radius: 0 8px 8px 0;
        background: #f5f8ff;
        overflow: hidden;
        flex-shrink: 0;
        }

        .captcha-addon img {
        height: 40px;
        cursor: pointer;
        display: block;
        }

        .captcha-refresh-ico {
        display: flex;
        align-items: center;
        padding: 0 10px;
        height: 100%;
        cursor: pointer;
        color: #4a6ab0;
        font-size: 0.82rem;
        border-left: 1px solid #c8d4f0;
        transition: background 0.15s;
        }

        .captcha-refresh-ico:hover {
        background: #dce6f8;
        color: #1a3a7a;
        }

        /* ── 記住我 ── */
        .remember-row {
        margin: 0.9rem 0 0.5rem;
        }

        .form-check-label {
        font-size: 0.87rem;
        color: #2a4070;
        }

        .form-check-input:checked {
        background-color: #1a3a7a;
        border-color: #1a3a7a;
        }

        /* ── 全寬登入按鈕 ── */
        .btn-login {
        width: 100%;
        background: linear-gradient(135deg, #1a3a7a, #0f2560);
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 0.6rem 1rem;
        font-size: 0.95rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        transition: opacity 0.2s, transform 0.15s, box-shadow 0.2s;
        box-shadow: 0 4px 16px rgba(15,37,96,0.38);
        margin-top: 0.5rem;
        }

        .btn-login:hover {
        opacity: 0.9;
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(15,37,96,0.46);
        color: #fff;
        }

        .btn-login:active {
        transform: translateY(0);
        }

        .forgot-link {
        display: block;
        text-align: center;
        margin-top: 0.9rem;
        font-size: 0.84rem;
        color: #3a5090;
        text-decoration: none;
        transition: color 0.2s;
        }

        .forgot-link:hover {
        color: #1a3a7a;
        text-decoration: underline;
        }

        .forgot-link i {
        margin-right: 0.3rem;
        }

        .login-card-footer {
        background: #f4f7ff;
        border-top: 1px solid #d0daee;
        text-align: center;
        padding: 0.7rem;
        font-size: 0.78rem;
        color: #4a6090;
        }

        .login-copyright {
        margin-top: 1.25rem;
        font-size: 0.76rem;
        color: rgba(140,175,240,0.55);
        text-align: center;
        letter-spacing: 0.02em;
        }

        /* ════════════════════════════════════════
        特色背景風：自訂背景圖片樣式
        ════════════════════════════════════════ */

        /* 背景圖層 div */
        .bg-layer {
        display: none;
        position: absolute;
        inset: -20px;
        z-index: 0;
        background: url('@Url.Content("~/image/Login/Logon_backgroud_Custom.png")') center / cover no-repeat;
        filter: blur(4px);
        animation: bgKenBurns 32s ease-in-out infinite alternate;
        will-change: transform;
        }
        /* 輕量遮罩：自然暗角 + 淡色調，保留背景辨識度 */
        .bg-layer::after {
        content: '';
        position: absolute;
        inset: 0;
        background:
        /* 柔和暗角：邊緣稍暗，中心留光 */
        radial-gradient(ellipse 75% 75% at 50% 48%, transparent 30%, rgba(0, 0, 0, 0.22) 100%),
        /* 底層淡色調壓暗，保留自然色彩 */
        rgba(0, 0, 0, 0.28);
        }
        /* Ken Burns 緩慢縮放位移：像攝影師輕推鏡頭，製造空間縱深 */
        @@keyframes bgKenBurns {
        0% {
        transform: scale(1.00) translate( 0.0%, 0.0%);
        }

        40% {
        transform: scale(1.04) translate(-0.8%, 0.5%);
        }

        100% {
        transform: scale(1.09) translate(-1.8%, 1.2%);
        }
        }

        /* 套用特色背景風時：顯示 bg-layer，移除科技風元素 */
        .login-wrapper.style-bg {
        background: #0d1117;
        }

        .login-wrapper.style-bg .bg-layer {
        display: block;
        }

        .login-wrapper.style-bg::before {
        background: none;
        }

        .login-wrapper.style-bg::after {
        background: none;
        }

        .login-wrapper.style-bg #tech-canvas,
        .login-wrapper.style-bg .scan-line {
        display: none;
        }

        .login-wrapper.style-bg .login-copyright {
        color: rgba(255, 255, 255, 0.55);
        }

        /* ── 動畫 ── */
        @@keyframes fadeDown {
        from {
        opacity: 0;
        transform: translateY(-16px);
        }

        to {
        opacity: 1;
        transform: translateY(0);
        }
        }

        @@keyframes fadeUp {
        from {
        opacity: 0;
        transform: translateY(20px);
        }

        to {
        opacity: 1;
        transform: translateY(0);
        }
        }

        @@media (max-width: 900px) {
        /* 手機版：Tab 按鈕隱藏，公告欄改為卡片下方靜態區塊 */
        .ann-tab {
        display: none !important;
        }

        .login-card-wrap {
        display: flex;
        flex-direction: column;
        }

        .ann-drawer {
        position: static !important;
        transform: none !important;
        opacity: 1 !important;
        pointer-events: auto !important;
        width: 100% !important;
        border-radius: 0 0 16px 16px !important;
        box-shadow: 0 6px 20px rgba(0,0,0,0.22) !important;
        margin-top: -1px; /* 與卡片底部無縫相連 */
        }
        /* 公告欄頁首隱藏折疊/關閉按鈕 */
        .ann-dw-toggle, .ann-dw-close {
        display: none !important;
        }
        /* 登入卡片底部圓角移除，改由公告欄底部接管 */
        .login-card {
        border-radius: 16px 16px 0 0 !important;
        }
        }

        @@media (max-width: 480px) {
        .login-section {
        width: 100%;
        }

        .login-area {
        padding: 1.25rem 0.75rem;
        }

        .style-switcher {
        top: 0.75rem;
        right: 0.75rem;
        }
        }

        /* ── 後台管理入口（右下角隱藏按鈕） ── */
        .admin-portal-link {
        position: fixed;
        bottom: 16px;
        right: 16px;
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: rgba(255,255,255,0.05);
        color: rgba(255,255,255,0.0);
        font-size: 14px;
        text-decoration: none;
        transition: all 0.4s ease;
        cursor: default;
        z-index: 10;
        }

        .admin-portal-link:hover {
        background: rgba(255,255,255,0.15);
        color: rgba(255,255,255,0.85);
        cursor: pointer;
        box-shadow: 0 0 12px rgba(100,160,255,0.3);
        }
    </style>
</head>
<body>

    <div class="login-wrapper">

        <!-- 特色背景風圖層（隱藏，切換風格時顯示）-->
        <div class="bg-layer"></div>

        <!-- 粒子 Canvas -->
        <canvas id="tech-canvas"></canvas>
        <!-- 掃描線 -->
        <div class="scan-line"></div>

        <!-- ── 右上角樣式切換器 ── -->
        <div class="style-switcher" id="styleSwitcher">
            <button class="style-btn" id="styleBtn" onclick="toggleStyleMenu()">
                <i class="fas fa-palette"></i>
                <span id="styleLabel">科技風</span>
                <i class="fas fa-chevron-down"></i>
            </button>
            <ul class="style-menu" id="styleMenu">
                <li class="style-menu-title">選擇登入樣版</li>
                <li class="style-item active" data-style="tech" data-label="科技風" onclick="selectStyle(this)">
                    <span class="style-dot"></span>科技風
                </li>
                <li class="style-item" data-style="bg" data-label="特色背景風" onclick="selectStyle(this)">
                    <span class="style-dot"></span>特色背景風
                </li>
            </ul>
        </div>

        <!-- ── 雙欄主版面 ── -->
        <div class="login-area">

            <!-- ═══ 左側：登入卡片 ═══ -->
            <div class="login-section">
                <div class="login-card-wrap">
                    <div class="login-card">

                        <!-- ①② Header：小圖示 + 品牌文字 -->
                        <div class="login-card-header">
                            <div class="card-header-unified">
                                <div class="brand-header-row">
                                    <!-- ① 小 Logo 圖示 -->
                                    <div class="brand-icon-wrap">
                                        <img src="~/image/Login/Logo.png" alt="Logo" class="brand-icon-img" />
                                    </div>
                                    <!-- ② 品牌文字（兩行） -->
                                    <div class="brand-text-block">
                                        <div class="brand-line1">@brandLine1</div>
                                        <div class="brand-line2">@brandLine2</div>
                                    </div>
                                </div>
                                <h5 class="card-login-title">使用者登入</h5>
                            </div>
                        </div>

                        <div class="login-card-body">
                            <form method="post" id="loginForm" action="@Url.Content("~/Account/Login")">
                                @Html.AntiForgeryToken()
                                <!-- 登入類型（隨 Tab 切換更新） -->
                                <input type="hidden" id="loginType" name="LoginType" value="normal" />

                                @if (!ViewData.ModelState.IsValid)
                                {
                                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                        {
                                            <i class="fas fa-exclamation-triangle me-1"></i>
                                            @error.ErrorMessage
                                            <br />
                                        }
                                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                    </div>
                                }

                                <!-- ③ 多元登入 Tabs -->
                                <div class="login-tabs">
                                    <div class="login-tab active" data-tab="normal" data-type="normal" onclick="switchTab(this)">一般登入</div>
                                    <div class="login-tab" data-tab="cert" data-type="cert" onclick="switchTab(this)">自然人憑證登入</div>
                                    <div class="login-tab" data-tab="ad" data-type="ad" onclick="switchTab(this)">AD驗證登入</div>
                                </div>

                                <!-- Tab 面板：一般登入（帳號 + 密碼 + 驗證碼） -->
                                <div class="tab-panel" id="panel-normal">
                                    <div class="simple-field">
                                        <i class="fas fa-user field-icon"></i>
                                        <input type="text" name="UxID" id="UxID" class="form-control simple-input"
                                               placeholder="帳號" value="@Model.UxID" />
                                    </div>
                                    <div class="simple-field password-toggle">
                                        <i class="fas fa-lock field-icon"></i>
                                        <input type="password" name="MbrKey" id="MbrKey" class="form-control simple-input"
                                               placeholder="密碼">
                                        <span class="simple-eye toggle-btn" title="顯示/隱藏密碼"><i class="fas fa-eye"></i></span>
                                    </div>
                                    <div class="simple-field captcha-wrap">
                                        <i class="fas fa-shield-alt field-icon"></i>
                                        <input type="text" class="form-control simple-input" name="DNTCaptchaInputText"
                                               id="captchaInput_normal" placeholder="驗證碼" />
                                        <div class="captcha-addon">
                                            <img id="captchaImage" src="" alt="驗證碼" title="點擊重新整理" onclick="loadCaptcha()" />
                                            <span class="captcha-refresh-ico" onclick="loadCaptcha()"><i class="fas fa-sync-alt"></i></span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Tab 面板：自然人憑證（密碼 + 驗證碼） -->
                                <div class="tab-panel d-none" id="panel-cert">
                                    <div class="simple-field" style="background:#f0f6ff;border-radius:8px;padding:0.6rem 0.85rem;margin-bottom:0.85rem;font-size:0.82rem;color:#2a4898;">
                                        <i class="fas fa-id-card field-icon" style="position:static;transform:none;margin-right:0.5rem;"></i>
                                        請插入自然人憑證讀卡機並確認憑證已就緒
                                    </div>
                                    <div class="simple-field password-toggle">
                                        <i class="fas fa-lock field-icon"></i>
                                        <input type="password" name="MbrKey" class="form-control simple-input"
                                               placeholder="憑證密碼 (PIN)">
                                        <span class="simple-eye toggle-btn" title="顯示/隱藏密碼"><i class="fas fa-eye"></i></span>
                                    </div>
                                    <div class="simple-field captcha-wrap">
                                        <i class="fas fa-shield-alt field-icon"></i>
                                        <input type="text" class="form-control simple-input" name="DNTCaptchaInputText"
                                               id="captchaInput_cert" placeholder="驗證碼" />
                                        <div class="captcha-addon">
                                            <img id="captchaImage_cert" src="" alt="驗證碼" title="點擊重新整理" onclick="loadCaptcha()" />
                                            <span class="captcha-refresh-ico" onclick="loadCaptcha()"><i class="fas fa-sync-alt"></i></span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Tab 面板：AD驗證（帳號 + 密碼 + 驗證碼） -->
                                <div class="tab-panel d-none" id="panel-ad">
                                    <div class="simple-field">
                                        <i class="fas fa-user field-icon"></i>
                                        <input type="text" name="UxID" class="form-control simple-input"
                                               placeholder="AD 帳號（網域\帳號）" />
                                    </div>
                                    <div class="simple-field password-toggle">
                                        <i class="fas fa-lock field-icon"></i>
                                        <input type="password" name="MbrKey" class="form-control simple-input"
                                               placeholder="AD 密碼">
                                        <span class="simple-eye toggle-btn" title="顯示/隱藏密碼"><i class="fas fa-eye"></i></span>
                                    </div>
                                    <div class="simple-field captcha-wrap">
                                        <i class="fas fa-shield-alt field-icon"></i>
                                        <input type="text" class="form-control simple-input" name="DNTCaptchaInputText"
                                               id="captchaInput_ad" placeholder="驗證碼" />
                                        <div class="captcha-addon">
                                            <img id="captchaImage_ad" src="" alt="驗證碼" title="點擊重新整理" onclick="loadCaptcha()" />
                                            <span class="captcha-refresh-ico" onclick="loadCaptcha()"><i class="fas fa-sync-alt"></i></span>
                                        </div>
                                    </div>
                                </div>

                                <!-- 記住我 -->
                                <div class="remember-row">
                                    <div class="form-check">
                                        <input type="checkbox" name="RememberMe" id="RememberMe"
                                               class="form-check-input" value="true"
                                        @(Model.RememberMe ? "checked" : "")>
                                        <label class="form-check-label" for="RememberMe">記住我</label>
                                    </div>
                                </div>

                                <!-- 全寬登入按鈕 -->
                                <button type="submit" class="btn btn-login" @(ViewBag.LoginDisabled == true ? "disabled" : "")>
                                    <i class="fas fa-sign-in-alt me-1"></i>登入
                                </button>

                                <a href="@Url.Action("ForgotPassword", "Account")" class="forgot-link">
                                    <i class="fas fa-key"></i>忘記密碼？
                                </a>

                                <input type="hidden" id="captchaToken" name="DNTCaptchaToken">
                                <input type="hidden" id="captchaText" name="DNTCaptchaText">
                            </form>
                        </div>

                        <div class="login-card-footer">
                            <i class="fas fa-lock me-1"></i>安全加密連線
                        </div>
                    </div>

                    <!-- ④ 公告 Tab 按鈕（右邊緣）-->
                    <button class="ann-tab" id="annTab" onclick="toggleAnnDrawer()">
                        <i class="fas fa-bullhorn ann-tab-icon"></i>
                        <span class="ann-tab-text">資訊公告</span>
                    </button>

                    <!-- ④ 公告抽屜（從右滑入）-->
                    <div class="ann-drawer" id="annDrawer">
                        <div class="ann-dw-header">
                            <i class="fas fa-bullhorn"></i>
                            <span class="ann-dw-title-label">資訊公告</span>
                            <span class="ann-dw-toggle" onclick="toggleAnnDrawer()">
                                展開/折疊&nbsp;<i class="fas fa-chevron-up" id="annChevron"></i>
                            </span>
                            <button class="ann-dw-close" onclick="toggleAnnDrawer()"><i class="fas fa-times"></i></button>
                        </div>
                        <table class="ann-dw-table">
                            <thead>
                                <tr>
                                    <th style="width:50px;">類型</th>
                                    <th>公告標題</th>
                                    <th style="width:80px;">日期</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Notices != null && Model.Notices.Count > 0)
                                {
                                    foreach (var item in Model.Notices)
                                    {
                                        <tr class="ann-dw-row-@item.SysnTypeCode">
                                            <td>
                                                <span class="ann-dw-badge bdg-@item.SysnTypeCode">@item.SysnTypeName</span>
                                            </td>
                                            <td><span class="ann-dw-cell-title" title="@item.SysnContent">@item.SysnContent</span></td>
                                            <td class="ann-dw-cell-date">@item.SysnPublicDt.ToString("yyyy-MM-dd")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-3">目前沒有公告</td>
                                    </tr>
                                }
                            </tbody>

                        </table>
                        <div class="ann-dw-footer">共 @(Model.Notices?.Count ?? 0) 則公告</div>
                    </div>

                </div><!-- /login-card-wrap -->

                <div class="login-copyright">
                    &copy; @DateTime.Now.Year &nbsp;@AppConfig.syi_title&nbsp; All Rights Reserved.
                </div>
            </div>

        </div><!-- /login-area -->
        <!-- 後台管理入口（右下角隱藏，hover 才顯示） -->
    </div>

    <script>
        /* ═══════════════════════════════════════════
        科技底圖：六角蜂巢網格動畫
        ═══════════════════════════════════════════ */
        (function () {
        const canvas = document.getElementById('tech-canvas');
        const ctx    = canvas.getContext('2d');

        // 藍色色票
        const C_BASE   = '45,110,200';   // 基礎藍
        const C_BRIGHT = '85,165,255';   // 高亮藍
        const C_FILL   = '30,80,170';    // 填充藍

        // 六角形設定（flat-top，外接圓半徑）
        const HEX_R = 52;
        const COL_W = HEX_R * 1.5;                   // 欄位水平間距
        const ROW_H = HEX_R * Math.sqrt(3);           // 列位垂直間距

        let W, H, cells = [], animId;

        /* ── 計算 flat-top 六角頂點 ── */
        function corners(cx, cy) {
        const pts = [];
        for (let i = 0; i < 6; i++) {
        const a = (Math.PI / 3) * i;
        pts.push({ x: cx + HEX_R * Math.cos(a), y: cy + HEX_R * Math.sin(a) });
        }
        return pts;
        }

        /* ── 建立六角格陣列 ── */
        function buildGrid() {
        cells = [];
        const cols = Math.ceil(W / COL_W) + 3;
        const rows = Math.ceil(H / ROW_H) + 3;
        for (let col = -1; col < cols; col++) {
        for (let row = -1; row < rows; row++) {
        const cx = col * COL_W;
        const cy = row * ROW_H + (col % 2 !== 0 ? ROW_H / 2 : 0);
        const g  = Math.random();          // 起始亮度 0~1
        cells.push({
        cx, cy,
        glow:       g,
        glowTarget: Math.random(),
        speed:      0.004 + Math.random() * 0.012,
        });
        }
        }
        }

        /* ── 繪製單一六角形 ── */
        function drawHex(cell) {
        const { cx, cy, glow } = cell;
        const pts = corners(cx, cy);

        ctx.beginPath();
        pts.forEach((p, i) => i === 0 ? ctx.moveTo(p.x, p.y) : ctx.lineTo(p.x, p.y));
        ctx.closePath();

        // 超過閾值時繪製兩層：外層厚線（光暈）+ 內層細線（核心）
        if (glow > 0.68) {
        const gA = ((glow - 0.68) / 0.32 * 0.28).toFixed(3);
        ctx.lineWidth   = 3.5;
        ctx.strokeStyle = `rgba(${C_BRIGHT},${gA})`;
        ctx.stroke();
        ctx.lineWidth   = 1;
        ctx.strokeStyle = `rgba(${C_BRIGHT},${(0.18 + glow * 0.45).toFixed(3)})`;
        ctx.stroke();

        // 輕微填充
        ctx.fillStyle = `rgba(${C_FILL},${(glow * 0.045).toFixed(3)})`;
        ctx.fill();

        // 頂點光點
        pts.forEach(p => {
        ctx.beginPath();
        ctx.arc(p.x, p.y, 1.8, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${C_BRIGHT},${(glow * 0.75).toFixed(3)})`;
        ctx.fill();
        });
        } else {
        // 普通邊線
        ctx.lineWidth   = 1;
        ctx.strokeStyle = `rgba(${C_BASE},${(0.08 + glow * 0.18).toFixed(3)})`;
        ctx.stroke();
        }
        }

        /* ── 更新亮度（緩慢隨機脈動）── */
        function update() {
        cells.forEach(c => {
        c.glow += (c.glowTarget - c.glow) * c.speed;
        if (Math.abs(c.glow - c.glowTarget) < 0.015) {
        // 大多數格子維持低亮度，少數脈衝高亮
        c.glowTarget = Math.random() < 0.15
        ? 0.7 + Math.random() * 0.3   // 亮起
        : Math.random() * 0.55;        // 暗沉
        }
        });
        }

        /* ── 主迴圈 ── */
        function loop() {
        ctx.clearRect(0, 0, W, H);
        update();
        cells.forEach(drawHex);
        animId = requestAnimationFrame(loop);
        }

        /* ── 初始化 ── */
        function init() {
        if (animId) cancelAnimationFrame(animId);
        W = canvas.width  = canvas.offsetWidth;
        H = canvas.height = canvas.offsetHeight;
        buildGrid();
        loop();
        }

        window.addEventListener('resize', init);
        init();
        })();

        /* ═══════════════════════════════════════════
        樣式切換器
        ═══════════════════════════════════════════ */
        function toggleStyleMenu() {
        const menu = document.getElementById('styleMenu');
        const btn  = document.getElementById('styleBtn');
        const open = menu.classList.toggle('open');
        btn.classList.toggle('open', open);
        }

        /* 套用指定風格到 .login-wrapper */
        function applyStyle(style) {
        const wrapper = document.querySelector('.login-wrapper');
        // 移除所有風格 class
        wrapper.classList.remove('style-bg');
        if (style === 'bg') {
        wrapper.classList.add('style-bg');
        }
        }

        function selectStyle(el) {
        document.querySelectorAll('.style-item').forEach(i => i.classList.remove('active'));
        el.classList.add('active');
        const label = el.dataset.label || el.textContent.trim();
        document.getElementById('styleLabel').textContent = label;
        const style = el.dataset.style;
        localStorage.setItem('loginStyle', style);
        applyStyle(style);
        document.getElementById('styleMenu').classList.remove('open');
        document.getElementById('styleBtn').classList.remove('open');
        }

        // 點擊外部關閉選單
        document.addEventListener('click', function (e) {
        if (!document.getElementById('styleSwitcher').contains(e.target)) {
        document.getElementById('styleMenu').classList.remove('open');
        document.getElementById('styleBtn').classList.remove('open');
        }
        });

        // 還原上次選擇並套用風格
        (function () {
        const saved = localStorage.getItem('loginStyle');
        if (saved) {
        const item = document.querySelector(`.style-item[data-style="${saved}"]`);
        if (item) {
        document.querySelectorAll('.style-item').forEach(i => i.classList.remove('active'));
        item.classList.add('active');
        document.getElementById('styleLabel').textContent = item.dataset.label || item.textContent.trim();
        applyStyle(saved);
        }
        }
        })();

        /* ═══════════════════════════════════════════
        公告抽屜 Drawer
        ═══════════════════════════════════════════ */
        function toggleAnnDrawer() {
        const drawer  = document.getElementById('annDrawer');
        const tab     = document.getElementById('annTab');
        const chevron = document.getElementById('annChevron');
        const isOpen  = drawer.classList.toggle('open');
        tab.classList.toggle('is-open', isOpen);
        chevron.className = isOpen ? 'fas fa-chevron-down' : 'fas fa-chevron-up';
        }

        // 點擊抽屜外部時關閉
        document.addEventListener('click', function (e) {
        const drawer = document.getElementById('annDrawer');
        const tab    = document.getElementById('annTab');
        if (drawer.classList.contains('open') &&
        !drawer.contains(e.target) && !tab.contains(e.target)) {
        drawer.classList.remove('open');
        tab.classList.remove('is-open');
        document.getElementById('annChevron').className = 'fas fa-chevron-up';
        }
        });

        /* ═══════════════════════════════════════════
        多元登入 Tab 切換
        ═══════════════════════════════════════════ */
        function switchTab(el) {
        // 更新 tab 按鈕狀態
        document.querySelectorAll('.login-tab').forEach(t => t.classList.remove('active'));
        el.classList.add('active');

        // 顯示對應面板，隱藏其他
        document.querySelectorAll('.tab-panel').forEach(p => {
        p.classList.add('d-none');
        // 停用隱藏面板的所有輸入欄位（避免提交空值被 required 擋住）
        p.querySelectorAll('input, textarea').forEach(i => i.disabled = true);
        });
        const active = document.getElementById('panel-' + el.dataset.tab);
        active.classList.remove('d-none');
        active.querySelectorAll('input, textarea').forEach(i => i.disabled = false);

        // 更新登入類型
        document.getElementById('loginType').value = el.dataset.type;
        }

        // 頁面載入時初始化：確保只有 panel-normal 的輸入可用
        (function initTabs() {
        document.querySelectorAll('.tab-panel').forEach(p => {
        if (p.id !== 'panel-normal') {
        p.querySelectorAll('input, textarea').forEach(i => i.disabled = true);
        }
        });
        })();

        /* ═══════════════════════════════════════════
        表單功能
        ═══════════════════════════════════════════ */
        $(function () {
        $(".password-toggle .toggle-btn").on("click", function () {
        let $w = $(this).closest(".password-toggle");
        let $i = $w.find("input[type='password'],input[type='text']").first();
        let $ic = $(this).find("i");
        if ($i.attr("type") === "password") {
        $i.attr("type", "text");
        $ic.removeClass("fa-eye").addClass("fa-eye-slash");
        } else {
        $i.attr("type", "password");
        $ic.removeClass("fa-eye-slash").addClass("fa-eye");
        }
        });
        });

        function loadCaptcha() {
        const url = '@Url.Content("~/Captcha/Generate")' + "?_=" + new Date().getTime();
        fetch(url)
        .then(r => r.json())
        .then(data => {
        // 同步更新三個面板的驗證碼圖片
        ['captchaImage', 'captchaImage_cert', 'captchaImage_ad'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.src = data.imageUrl;
        });
        document.getElementById('captchaToken').value = data.captchaToken;
        document.getElementById('captchaText').value  = data.captchaText;
        })
        .catch(err => console.error("載入驗證碼錯誤：", err));
        }

        window.onload = loadCaptcha;

        document.getElementById("loginForm").addEventListener("submit", function () {
        Swal.fire({
        title: '處理中...', text: '請稍候，正在登入系統',
        allowOutsideClick: false,
        didOpen: () => { Swal.showLoading(); }
        });
        });
    </script>
    @await Html.PartialAsync("_SwalMessages")
</body>
</html>
