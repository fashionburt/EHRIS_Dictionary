                                    var appRoot = '@Url.Content("~")';
        
                                    window.IdleConfig = {
                                        idleSeconds: @Configuration["IdleSettings:IdleTimeoutSeconds"],
                                        warningSeconds: @Configuration["IdleSettings:WarningSeconds"],
