                            <script src="~/js/EHRISlayout.js" asp-append-version="true" charset="utf-8"></script>
                            <!-- [Claude] 色彩主題選擇器 -->
                            <script>
                                (function () {
                                    var themes = {
                                        blue:   { c1: '#1a3a5f', c2: '#2a5298', c3: '#1e3c72' },
                                        green:  { c1: '#1a3d2b', c2: '#1e6e4a', c3: '#155a38' },
                                        purple: { c1: '#2d1b4e', c2: '#5a3a8a', c3: '#3d2266' },
                                        teal:   { c1: '#0f3040', c2: '#1a6872', c3: '#0a4050' },
                                        wine:   { c1: '#4a1a2a', c2: '#8a2040', c3: '#3c1020' },
                                        slate:  { c1: '#1f2c3a', c2: '#374c60', c3: '#1a2432' }
                                    };

                                    function applyTheme(name) {
                                        var t = themes[name];
                                        if (!t) return;
                                        var root = document.documentElement;
                                        root.style.setProperty('--theme-c1', t.c1);
                                        root.style.setProperty('--theme-c2', t.c2);
                                        root.style.setProperty('--theme-c3', t.c3);
                                        // home-hero 使用 CSS var() + background-attachment:fixed，
                                        // 不需 JS inline 覆寫（inline 會抹掉 fixed，造成接縫）
                                        // 同步 launcher-overlay 背景（手機版）
                                        var overlay = document.querySelector('.launcher-overlay');
                                        if (overlay) overlay.style.background = t.c1;
                                        // 更新 Header 左側圓點（顯示目前主題色）
                                        var dot = document.getElementById('theme-current-dot');
                                        if (dot) dot.style.background = t.c2;
                                        // 更新下拉選單 active 狀態
                                        document.querySelectorAll('.theme-option').forEach(function (el) {
                                            el.classList.toggle('active', el.dataset.theme === name);
                                        });
                                        localStorage.setItem('ehris-theme', name);
                                    }

                                    // 初始化
                                    $(function () {
                                        var saved = localStorage.getItem('ehris-theme') || 'blue';
                                        applyTheme(saved);
                                        document.querySelectorAll('.theme-option').forEach(function (el) {
                                            el.addEventListener('click', function (e) {
                                                e.preventDefault();
                                                applyTheme(this.dataset.theme);
                                            });
                                        });
                                    });
                                })();
                            </script>
                            <!-- 倒數 js -->
                            <script src="~/js/IdleTimer.js"></script>
                            @await Html.PartialAsync("_SwalMessages")
                            @RenderSection("Scripts", required: false)

                        </body>
