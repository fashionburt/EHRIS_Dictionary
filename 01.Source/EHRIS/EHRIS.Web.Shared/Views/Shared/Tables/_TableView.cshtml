@using EHRIS.Web.Shared.Models
@model CommonTableModel

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="@Model.TableId" class="table table-striped table-sm table-hover"
                   style="@(string.IsNullOrEmpty(Model.MinWidth) ? "width:100%" : $"min-width:{Model.MinWidth};width:100%")">
                <thead>
                    <tr>
                        @foreach (var col in Model.Columns)
                        {
                            <th class="@col.CssClass"
                                style="@(string.IsNullOrEmpty(col.Width) ? "" : $"width:{col.Width}")">
                                @Html.Raw(col.Label)
                            </th>
                        }
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>
