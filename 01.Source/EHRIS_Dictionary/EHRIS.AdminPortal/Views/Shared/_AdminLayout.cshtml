@using EHRIS.Core.Models.Common
@{
    string userName = ViewBag.UserName ?? "管理員";
}

<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(ViewData["Title"] ?? "後台客服系統")</title>

    <!-- CSS（與前台共用） -->
    <link rel="stylesheet" href="~/lib/admin-lte/css/adminlte.min.css">
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/lib/sweetalert2/sweetalert2.min.css" />
    <link rel="stylesheet" href="~/css/EHRISsite.css" />

    <link rel="stylesheet" href="~/lib/datatable/css/dataTables.min.css">
    <link rel="stylesheet" href="~/lib/datatable/css/datatables.bootstrap5.min.css" />


    <!-- 後台覆寫：Header 改為淺色，文字深色可讀 -->
    <style>
        .app-header#navigation {
            background: #ffffff !important;
            border-bottom: 2px solid #2c3e50 !important;
            box-shadow: 0 1px 4px rgba(0,0,0,0.08) !important;
        }

            .app-header#navigation .nav-link {
                color: #2c3e50 !important;
            }

                .app-header#navigation .nav-link:hover {
                    color: #e67e22 !important;
                }

            .app-header#navigation .adm-title {
                color: #2c3e50;
                font-weight: 700;
                font-size: 0.92rem;
            }

            .app-header#navigation .adm-user-badge {
                background: #f0f4f8;
                color: #2c3e50;
                border-radius: 4px;
                padding: 2px 10px;
                font-size: 0.85rem;
            }
        /* 內容區背景 */
        .app-main {
            background: #f5f6fa !important;
        }
    </style>

    <!-- JS（與前台共用） -->
    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/admin-lte/js/adminlte.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>

    <script src="~/js/config/projectMap.js" asp-append-version="true" charset="utf-8"></script>
    <script src="~/lib/datatable/js/jquery.datatables.min.js"></script>
    <script src="~/lib/datatable/datatables-buttons/js/datatables.buttons.min.js"></script>
    <script src="~/lib/datatable/js/datatables.bootstrap5.min.js"></script>

    <script src="~/js/EHRISsite.js"></script>
    <script src="~/js/EHRISlayout.js"></script>
</head>
<body class="layout-fixed sidebar-expand-lg sidebar-mini sidebar-collapse bg-body-tertiary app-loaded">
    <div class="app-wrapper">

        <!-- ═══ Header ═══ -->
        <nav class="app-header navbar navbar-expand bg-body" id="navigation">
            <div class="container-fluid d-flex align-items-center p-0">
                <ul class="navbar-nav flex-shrink-0">
                    <li class="nav-item d-none d-md-block">
                        <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button">
                            <i class="bi bi-pin-angle"></i>
                        </a>
                    </li>
                    <li class="nav-item d-flex align-items-center">
                        <span class="adm-title ms-2">
                            <i class="fas fa-headset me-1" style="color:#e67e22;"></i>後台客服系統
                        </span>
                    </li>
                </ul>
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item d-flex align-items-center me-2">
                        <span class="adm-user-badge">
                            <i class="fas fa-user-shield me-1"></i>@userName
                        </span>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/" title="前台首頁">
                            <i class="fas fa-home"></i>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Content("~/AdminPortal/Account/Login")" title="登出">
                            <i class="fas fa-sign-out-alt"></i>
                        </a>
                    </li>
                </ul>
            </div>
        </nav>

        <!-- ═══ Sidebar（透過 AdminMenuViewComponent 動態載入） ═══ -->
        @await Component.InvokeAsync("AdminMenu")

        <!-- ═══ Content ═══ -->
        <main class="app-main">
            <div id="mvcContent">
                @RenderBody()
            </div>
        </main>

    </div>
    <script>
            var appRoot = '@Url.Content("~")';
        
    </script>
    @await Html.PartialAsync("_SwalMessages")
</body>
</html>
