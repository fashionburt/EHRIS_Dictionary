@using EHRIS.Core.Models.AdminPortal
@using EHRIS.Web.Shared.Models
@model List<AdminRoleListViewModel>
@{
    bool isAjax = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest";
    Layout = isAjax ? null : "_AdminLayout";
}

<link href="~/css/Button.css" rel="stylesheet" />
<link href="~/css/AdminButton.css" rel="stylesheet" />
<script src="~/lib/jquery-treegrid/js/jquery.treegrid.min.js"></script>

<section class="content admin-workspace">
    <div class="container-fluid">
        @await Html.PartialAsync("_TableView", new CommonTableModel
        {
            TableId = "roleTable",
                Columns = new[]
                {
                new TableColDef("角色名稱", "", "15%"),
                new TableColDef("描述", "", "26%"),
                new TableColDef("是否啟用", "text-center", "10%"),
                new TableColDef("變動時間", "text-center", "15%"),
                new TableColDef("人員明細", "text-center", "7%"),
                new TableColDef("設定權限", "text-center", "7%"),
                new TableColDef("修改", "text-center", "5%"),
                new TableColDef("刪除", "text-center", "5%")
                }
                })
    </div>
</section>

<div class="modal modal-admin" id="roleModal" tabindex="-1" aria-labelledby="roleModalLabel">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="roleModalLabel">新增角色</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="roleForm">
                    @Html.AntiForgeryToken()
                    <div class="mb-2">
                        <label class="form-label">角色名稱<span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="adrRoleName" name="adrRoleName">
                    </div>
                    <div class="mb-2">
                        <label class="form-label">角色描述</label>
                        <textarea class="form-control" id="adrRoleMemo" rows="3"></textarea>
                    </div>
                    <div class="mb-2">
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" id="adrStatus" name="adrStatus">
                            <label class="form-check-label" for="adrStatus">啟用</label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary btn-sm" id="btnSaveRole">儲存</button>
                <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">取消</button>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("ADS999002EDT", Model)
@await Html.PartialAsync("_AdminPeople", Model)

<script>
    window.permissionAction = {
        pageUrl: '@Url.Action("ADS999002", "ADS999002")',
        GetAllRoleList: '@Url.Action("GetAllRoleList", "ADS999002")',
        UpdatePermission: '@Url.Action("UpdatePermission", "ADS999002")',
        GetRoleByNo: '@Url.Action("GetRoleByNo", "ADS999002")',
        DeleteRole: '@Url.Action("DeleteRole", "ADS999002")',
        GetPermission: '@Url.Action("GetPermission", "ADS999002")',
        GetPeople: '@Url.Action("GetPeople", "ADS999002")',
        AddRole: '@Url.Action("AddRole", "ADS999002")',
        UpdateRole: '@Url.Action("UpdateRole", "ADS999002")',
        dataTableLangUrl: '@Url.Content("~/lib/datatables.net/plug-ins/i18n/zh-HANT.json")',
        tokenValue: $('input[name="__RequestVerificationToken"]').val(),
        hasInsertPermission: @(ViewBag.AddStatus?.ToString().ToLower() ?? "false")
    };
</script>