@inject EHRIS.Security.User.IUserContextService userContext

@using EHRIS.Web.Shared.Models
@{
    bool isAjax = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest";
    Layout = isAjax ? null : "_AdminLayout";
}

<link href="~/css/Button.css" rel="stylesheet" />
<link href="~/css/AdminButton.css" rel="stylesheet" />

<section class="content admin-workspace">
    <div class="container-fluid">
        @await Html.PartialAsync("_TableView", new CommonTableModel
        {
            TableId = "userTable",
            Columns = new[]
            {
                new TableColDef("帳號", "", "10%"),
                new TableColDef("姓名", "", "10%"),
                new TableColDef("Email", "", "20%"),
                new TableColDef("角色", "", "30%"),
                new TableColDef("狀態", "text-center", "10%"),
                new TableColDef("修改時間", "text-center", "10%"),
                new TableColDef("修改", "text-center", "5%"),
                new TableColDef("刪除", "text-center", "5%")
            }
        })
    </div>
</section>

<div class="modal modal-admin" id="userModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="userModalLabel">使用者編輯</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="modal-body">
                    <form id="userForm" class="row g-3">
                        @Html.AntiForgeryToken()
                        <div class="col-md-6">
                            <label class="form-label">登入帳號<span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="aduLogin" readonly>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">姓名<span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="aduDisplayName">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">電子郵件<span class="text-danger">*</span></label>
                            <input type="email" class="form-control" id="aduEmail">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">登入密碼<span class="text-danger" id="pwdStar">*</span></label>
                            <input type="password" class="form-control" id="aduPassword" placeholder="需變更請輸入新密碼" autocomplete="new-password">
                        </div>

                        <div class="col-12 mt-0">
                            <small class="form-text text-muted">
                                <span class="text-warning">★</span> 密碼須包含
                                <strong class="text-danger">大寫字母、小寫字母、數字等三種</strong>。
                                <br />
                                <span class="text-warning">★</span> 長度需介於 <strong class="text-danger">8-20 碼</strong>。
                            </small>
                            <small class="form-text text-muted d-block">
                                <span class="text-warning">★</span> 密碼不可與帳號相同。
                            </small>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label">權限等級<span class="text-danger">*</span></label>
                            <select class="form-select" id="adlNo"></select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">角色<span class="text-danger">*</span></label>
                            <div id="roleList" class="d-flex flex-wrap gap-2 p-2 border rounded"></div>
                        </div>
                        <div class="col-12">
                            <label class="form-label d-block">使用者狀態<span class="text-danger">*</span></label>
                            <div class="d-flex align-items-center gap-2">
                                <span>不啟用</span>
                                <div class="form-check form-switch m-0 p-0" style="min-height: auto;">
                                    <input class="form-check-input m-0" type="checkbox" id="aduStatus" />
                                </div>
                                <span>啟用</span>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary btn-sm" id="btnSaveUser">儲存</button>
                <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">取消</button>
            </div>
        </div>
    </div>
</div>

<script>
    window.userAction = {
        list: '@Url.Action("GetAllUserList")',
        data: '@Url.Action("GetUserData")',
        save: '@Url.Action("SaveUser")',
        del: '@Url.Action("DeleteUser")',
        tokenValue: $('input[name="__RequestVerificationToken"]').val(),
        hasAdd: @(ViewBag.AddStatus?.ToString().ToLower() ?? "false"),
        myRank: @userContext.AdlRank,
        dataTableLangUrl: '@Url.Content("~/lib/datatables.net/plug-ins/i18n/zh-HANT.json")',
    };

    console.log("目前登入者位階：", window.userAction.myRank);
</script>