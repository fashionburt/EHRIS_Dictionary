@using EHRIS.Web.Shared.Models
@model dynamic
@{
    ViewData["Title"] = "系統參數設定";
    Layout = "_LayoutSub";
}
<link href="~/css/DataTableStyles.css" rel="stylesheet" />
<link href="~/css/EHRISsite.css" rel="stylesheet" />
<link href="~/css/Button.css" rel="stylesheet" />

<section class="content">
    @await Html.PartialAsync("_TableView", new CommonTableModel
    {
        TableId = "itemTable",
        Columns = new[]
        {
            new TableColDef("參數變數",     "dt-col-max"),
            new TableColDef("參數說明",     "dt-col-max"),
            new TableColDef("參數值",       "dt-col-mid"),
            new TableColDef("預設參數值",   "dt-col-mid"),
            new TableColDef("開放</br>人事",   "dt-col-min"),
            new TableColDef("建修人", "dt-col-mod"),
            new TableColDef("建修時間", "dt-col-time"),
            new TableColDef("修改",         "dt-col-action"),
            new TableColDef("刪除",         "dt-col-action"),
        }
    })
</section>

<div class="modal modal-morandi" id="itemModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="itemModalLabel"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="max-height: 80vh; overflow-y: auto;">
                <form id="itemForm">
                    @Html.AntiForgeryToken()

                    <div>
                        <div class="row">
                            <div class="col-md-4 mb-1">
                                <label class="form-label">分類項<span class="text-danger">*</span></label>
                                <select class="form-select" id="agr_group" name="agr_group">
                                    @if (ViewBag.GroupList != null)
                                    {
                                        @foreach (var item in ViewBag.GroupList as List<EHRIS.Core.Entities.ArgumentsGroup>)
                                        {
                                            <option value="@item.AgrGroup">@($"{item.AgrText} ({item.AgrGroup})")</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-5 mb-1">
                                <label class="form-label">變數名稱<span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="arg_variable" name="arg_variable" placeholder="不含分類項名稱">
                            </div>
                            <div class="col-md-3 mb-1">
                                <label class="form-label">排序<span class="text-danger">*</span></label>
                                <input type="number" class="form-control" id="arg_order" name="arg_order">
                            </div>
                        </div>

                        <div class="mb-1">
                            <label class="form-label">參數說明<span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="arg_describe" name="arg_describe">
                        </div>
                        <div class="mb-1">
                            <label class="form-label">詳細敘述</label>
                            <textarea class="form-control" id="arg_deatil" name="arg_deatil" rows="2"></textarea>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-1">
                                <label class="form-label">目前變數值<span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="arg_value" name="arg_value">
                            </div>
                            <div class="col-md-6 mb-1">
                                <label class="form-label">預設變數值</label>
                                <input type="text" class="form-control" id="arg_defaultvalue" name="arg_defaultvalue">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-1">
                                <div class="row align-items-center">
                                    <label class="col-md-auto col-form-label">變數來源類型</label>
                                    <div class="col-md-auto">
                                        <select class="form-select" id="arg_source" name="arg_source">
                                            <option value="TEXT">TEXT</option>
                                            <option value="INT">INT</option>
                                            <option value="SPLITTEXT">SPLITTEXT</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6 mb-1">
                                <div class="row align-items-center">
                                    <label class="col-md-auto col-form-label">文字分隔符號</label>
                                    <div class="col-md-auto">
                                        <input type="text" class="form-control" id="arg_splitchar" name="arg_splitchar">
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="mt-1 p-1 border rounded-3">
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="d-flex flex-column align-items-center">
                                        <label class="form-label mb-1">多選制</label>
                                        <div class="d-flex align-items-center gap-2">
                                            <span>否</span>
                                            <div class="form-check form-switch m-0">
                                                <input class="form-check-input cursor-pointer" type="checkbox" id="arg_multisel">
                                            </div>
                                            <span>是</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="d-flex flex-column align-items-center">
                                        <label class="form-label mb-1">開放人事</label>
                                        <div class="d-flex align-items-center gap-2">
                                            <span>否</span>
                                            <div class="form-check form-switch m-0">
                                                <input class="form-check-input cursor-pointer" type="checkbox" id="arg_openmanager">
                                            </div>
                                            <span>是</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="d-flex flex-column align-items-center">
                                        <label class="form-label mb-1">必填</label>
                                        <div class="d-flex align-items-center gap-2">
                                            <span>否</span>
                                            <div class="form-check form-switch m-0">
                                                <input class="form-check-input cursor-pointer" type="checkbox" id="arg_required">
                                            </div>
                                            <span>是</span>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary btn-sm" id="btnSaveItem">儲存</button>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">取消</button>
            </div>
        </div>
    </div>
</div>

<script>
    window.permissionAction = {
    pageUrl: '@Url.Action("ADS999004", "ADS999004")',
    GetList: '@Url.Action("GetList", "ADS999004")',
    GetByVariable: '@Url.Action("GetByVariable", "ADS999004")',
    Add: '@Url.Action("Add", "ADS999004")',
    Update: '@Url.Action("Update", "ADS999004")',
    Delete: '@Url.Action("Delete", "ADS999004")',
    SetLang: '@Url.Content("~/lib/datatables.net/plug-ins/i18n/zh-HANT.json")',
    tokenValue: $('input[name="__RequestVerificationToken"]').val(),
    hasInsertPermission: @Html.Raw(Json.Serialize(ViewBag.AddStatus ?? false))
    };
</script>