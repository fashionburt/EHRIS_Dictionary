@model dynamic
<link href="/css/DataTableStyles.css" rel="stylesheet" />
<link href="/css/Button.css" rel="stylesheet" />
<link href="/css/MutliSelect.css" rel="stylesheet" />

<section class="content">
    <div class="container-fluid">
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="card-title fw-bold"><i class="fa-solid fa-bullhorn me-2"></i>公告管理</h5>
                    @if (ViewBag.AddStatus)
                    {
                        <button type="button" class="btn btn-primary btn-sm" onclick="window.DIC1996.openModal()">
                            <i class="fas fa-plus me-1"></i>新增公告
                        </button>
                    }
                </div>
                <hr />
                <form id="searchForm" class="row g-3">
                    @Html.AntiForgeryToken()
                    <div class="col-md-4">
                        <label class="form-label fw-bold">關鍵字</label>
                        <div class="input-group input-group-sm">
                            <input type="text" id="txtKeyword" class="form-control" placeholder="搜尋公告內容..." />
                            <button type="button" class="btn btn-primary" id="btnSearch">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table id="announcementTable" class="table table-bordered table-hover w-100 table-sm">
                        <thead class="table-light text-center">
                            <tr>
                                <th class="dt-col-min">層級</th>
                                <th class="dt-col-max">公告訊息</th>
                                <th class="dt-col-min">狀態</th>
                                <th class="dt-col-time">開始時間</th>
                                <th class="dt-col-time">結束時間</th>
                                <th class="dt-col-min">修改</th>
                                <th class="dt-col-min">刪除</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="modal fade modal-morandi" id="editModal" tabindex="-1" aria-labelledby="modalTitle" aria-hidden="true" data-bs-focus="false">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">編輯公告</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editForm">
                    <input type="hidden" id="editId" value="0" />
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">公告訊息</label>
                            <textarea id="editMessage" class="form-control" rows="3" required></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">層級</label>
                            <select id="editPriority" class="form-select">
                                <option value="0">一般公告</option>
                                <option value="1">維護公告</option>
                                <option value="2">緊急公告</option>
                            </select>
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="editIsEnabled" checked>
                                <label class="form-check-label" for="editIsEnabled">是否啟用</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">開始時間</label>
                            <input type="datetime-local" id="editStartDate" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">結束時間</label>
                            <input type="datetime-local" id="editEndDate" class="form-control" required />
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-morandi-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-morandi-primary" onclick="window.DIC1996.save()">儲存</button>
            </div>
        </div>
    </div>
</div>

<script>
    window.permissionAction = {
        getData: '@Url.Action("GetData", "DIC1996")',
        getById: '@Url.Action("GetById", "DIC1996")',
        create: '@Url.Action("Create", "DIC1996")',
        update: '@Url.Action("Update", "DIC1996")',
        delete: '@Url.Action("Delete", "DIC1996")',
        dataTableLangUrl: '@Url.Content("~/lib/datatables.net/plug-ins/i18n/zh-HANT.json")',
        tokenName: '__RequestVerificationToken',
        tokenValue: $('input[name="__RequestVerificationToken"]').val()
    };
</script>