<div class="modal   modal-morandi" id="changePasswordModal" tabindex="-1" aria-labelledby="changePasswordModalLabel" data-bs-backdrop="static" data-bs-keyboard="false" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header ">
                <h6 class="modal-title" id="changePasswordModalLabel">變更密碼</h6>
                <button type="button" class="btn-close " data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="changePasswordForm" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-0">
                        <label class="form-label">舊密碼</label><span class="text-danger">*</span>
                        <div class="input-group">
                        <input type="password" name="OldPassword" class="form-control form-control-sm" required />
                        <button type="button" class="btn btn-outline-secondary btn-sm toggle-password" tabindex="-1">
                            <i class="fas fa-eye"></i>
                        </button>
                        </div>
                        <span class="text-danger field-validation" data-valmsg-for="OldPassword"></span>
                    </div>
                    <div class="mb-0">
                        <label class="form-label">新密碼</label><span class="text-danger">*</span>
                        <div class="input-group">
                        <input type="password" name="NewPassword" class="form-control form-control-sm" required />
                        <button type="button" class="btn btn-outline-secondary btn-sm toggle-password" tabindex="-1">
                            <i class="fas fa-eye"></i>
                        </button>
                        </div>
                        <span class="text-danger field-validation" data-valmsg-for="NewPassword"></span>
                    </div>
                    <div class="mb-0">
                        <label class="form-label">確認新密碼</label><span class="text-danger">*</span>
                        <div class="input-group">
                            <input type="password" name="ConfirmPassword" class="form-control form-control-sm" required />
                            <button type="button" class="btn btn-outline-secondary btn-sm toggle-password" tabindex="-1">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                        <span class="text-danger field-validation" data-valmsg-for="ConfirmPassword"></span>
                    </div>
                    <div class="row">
                        <div class="col-12 mt-0">
                            <div class="form-text text-muted">
                                <span class="text-warning">★</span> 密碼須包含
                                <strong class="text-danger">大寫字母、小寫字母、數字等三種</strong>
                                ，長度需介於 <strong class="text-danger">8-20 碼</strong>。
                            </div>
                            <div class="form-text text-muted d-block">
                                <span class="text-warning">★</span> 密碼不可與帳號相同。
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">取消</button>
                <button type="button" id="btnSavePassword" class="btn btn-primary btn-sm">儲存</button>
            </div>
        </div>
    </div>
</div>
