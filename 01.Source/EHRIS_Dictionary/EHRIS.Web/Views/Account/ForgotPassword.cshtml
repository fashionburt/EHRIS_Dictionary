@model ForgetPasswordModel
@addTagHelper *, DNTCaptcha.Core
@using EHRIS.Core.Models.Common

@{
    ViewData["Title"] = "忘記密碼";
    Layout = null; // 不使用主版面
}


<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>忘記密碼</title>
    <!-- AdminLTE & Bootstrap -->
    <link rel="stylesheet" href="~/lib/admin-lte/css/adminlte.min.css">
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap-datepicker/css/bootstrap-datepicker.min.css" />
    <!--jQuery-->
    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js" type="text/javascript" asp-append-version="true"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js" type="text/javascript" asp-append-version="true"></script>
    <script src="~/lib/jquery-ajax-unobtrusive-main/jquery.unobtrusive-ajax.js" type="text/javascript" asp-append-version="true"></script>
    <!-- Bootstrap 5 -->
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/bootstrap-datepicker/js/bootstrap-datepicker.min.js"></script>
    <script src="~/lib/bootstrap-datepicker/locales/bootstrap-datepicker.zh-TW.min.js"></script>
    <!-- AdminLTE JS -->
    <script src="~/lib/admin-lte/js/adminlte.min.js"></script>

    <!-- SweetAlert2 CSS -->
    <link rel="stylesheet" href="~/lib/sweetalert2/sweetalert2.min.css" />

    <!-- SweetAlert2 JS -->
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
<style>
        /* 整個登入頁背景 */
        body.login-page {
            background-color: #a8b4be; /* 淺藍灰，比較柔和 */
            color: #2c3e50;
            font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
        }
        /* 登入框 */
        .login-box {
            width: 400px;
            margin: 5% auto;
        }

            .login-box .card {
                border-radius: 12px;
                border: none;
                box-shadow: 0 6px 16px rgba(0,0,0,0.15);
            }

            /* Card header */
            .login-box .card-header {
                background-color: #3a506b; /* 深藍灰 */
                color: #fff;
                border-radius: 12px 12px 0 0;
            }

            /* Card footer */
            .login-box .card-footer {
                background-color: #f8f9fa;
                border-top: 1px solid #dee2e6;
            }

            /* 輸入框 */
            .login-box .form-control {
                border-radius: 8px;
                border: 1px solid #7b8a97;
            }

                .login-box .form-control:focus {
                    border-color: #3a506b;
                    box-shadow: 0 0 6px rgba(58, 80, 107, 0.3);
                }

            /* 主按鈕 */
            .login-box .btn-primary {
                background-color: #3a506b;
                border-color: #3a506b;
            }

            .login-box .btn-primary:hover {
                background-color: #2c3e50;
                border-color: #2c3e50;
            }
            /* 返回登入連結 */
            .login-box a.btn-outline-primary {
                border-radius: 20px;
                color: #3a506b;
                border-color: #3a506b;
                font-size: 0.9rem;
            }

            .login-box a.btn-outline-primary:hover {
                background-color: #3a506b;
                color: #fff;
            }
</style>
</head>

<body class="hold-transition login-page">

    <div class="login-box">
        <!-- Logo 區 -->
        <div class="login-logo">
            <b>@AppConfig.syi_title</b>
        </div>

        <!-- Card -->
        <div class="card card-outline card-primary shadow">
            <div class="card-header text-center">
                <h3 class="card-title">忘記密碼</h3>
            </div>

            <div class="card-body">
                <p class="login-box-msg">
                    請輸入您的身分證號及生日，我們將寄送重設密碼的驗證碼。
                </p>

                <form id="forgetForm">
                    @Html.AntiForgeryToken() <!--  防止 CSRF 攻擊 -->
                   
                    <!-- 身分證 -->
                    <div class="input-group mb-3">
                        <div class="input-group-text">
                            <span class="fas fa-id-card"></span>
                        </div>
                        <input type="text" name="IdCard" id="IdCard" class="form-control" placeholder="身分證號" required />
                        
                        <span class="text-danger field-validation" data-valmsg-for="IdCard"></span>
                    </div>

                    <!-- 生日 -->
                    <div class="input-group mb-3">
                        <div class="input-group-text">
                            <span class="fas fa-birthday-cake"></span>
                        </div>
                       @*  <input type="date" name="Birthday" id="Birthday" class="form-control" placeholder="生日 (YYYY-MM-DD)" required /> *@
                        <input type="text" id="Birthday" name="Birthday" class="form-control" placeholder="生日 (YYY-MM-DD)" required>
                        <span class="text-danger field-validation" data-valmsg-for="Birthday"></span>
                    </div>

                    <!-- 驗證碼 -->
                    <div class="input-group mb-3 ">
                        <span class="input-group-text">
                            <i class="fas fa-shield-alt"></i>
                        </span>

                        <input type="text" class="form-control" name="DNTCaptchaInputText" placeholder="請輸入驗證碼" required />
                        <span class="input-group-text p-0 border-0 bg-white">
                            <img id="captchaImage" src="" alt="Captcha" style="cursor:pointer; height:38px;" />
                        </span>
                        <span class="input-group-text " style="cursor:pointer;" onclick="loadCaptcha()">
                            <i class="fas fa-sync"></i>
                        </span>


                    </div>

                    <div class="row">
                        <div class="col-8 ">
                            <a href="@Url.Action("Login", "Account")" class="btn btn-sm btn-outline-primary">返回登入</a>
                        </div>
                        <div class="col-4">
                            <button class="btn btn-primary btn-block" type="submit">送出</button>
                            
                        </div>
                    </div>
                    <!-- 必要隱藏欄位 -->
                    <input type="hidden" id="captchaToken" name="DNTCaptchaToken">
                    <input type="hidden" id="captchaText" name="DNTCaptchaText">
                </form>
            </div>
        </div>
    </div>

   
</body>
</html>
<script>

    $(function () {

        
          /** datepicker宣告 */
              $('#Birthday').datepicker({
                     format: "yyyy-mm-dd",     // 格式：2025/10/11
                     language: "zh-TW",        // 中文介面
                     autoclose: true,          // 選完自動關閉
                     todayHighlight: true,     // 今天標示
                     orientation: "bottom auto"
                 });

                  // 取得當前日期
                   var now = new Date();
                   var year = now.getFullYear() - 1911;
                   var dayText = year + '-' + String(now.getMonth() + 1).padStart(2, '0')+'-'+String(now.getDate() + 1).padStart(2, '0') ;
                
                   $('#Birthday').datepicker('update', dayText);
                

     $('#forgetForm').on('submit', function (e) {
        e.preventDefault();
           
           let isValid = true;
           
           //檢查必填
           if ($('#IdCard').val().trim() === '') {
               $('[data-valmsg-for="IdCard"]').text('身分證號必填');
               isValid = false;
           }
            let birthDate = $('#Birthday').val().trim();

            if (birthDate === '') {
                $('[data-valmsg-for="Birthday"]').text('生日必填');
                isValid = false;
            } else if (isNaN(Date.parse(birthDate))) {
                $('[data-valmsg-for="Birthday"]').text('生日格式不正確');
                isValid = false;
            }
            
           // 如果不合法就不送出
           if (!isValid) return;
           let formArray = $("#forgetForm").serializeArray();
           let formData = {};

            formArray.forEach(function(item){
                if(item.name === "Birthday" && item.value){
                    // 民國轉西元
                    let parts = item.value.split("-");
                    if(parts.length === 3){
                        let y = parseInt(parts[0], 10) + 1911; // ROC -> AD
                        let m = parts[1];
                        let d = parts[2];
                        formData[item.name] = `${y}-${m}-${d}`;
                    } else {
                        formData[item.name] = item.value;
                    }
                    
                } else {
                    formData[item.name] = item.value;
                }
            });
           // 顯示處理中
           Swal.fire({
               title: '處理中...',
               allowOutsideClick: false,
               didOpen: () => {
                   Swal.showLoading(); // 轉圈動畫
               }
           });
           let token = $('input[name="__RequestVerificationToken"]').val();
           const url =  '/Account/ForgotPassword' ;
           var appRoot = '@Url.Content("~")';
           $.ajax({
             url: appRoot + url,
             type: 'POST',
            headers: {
                'RequestVerificationToken': token
            },
             data: formData,
             success: function(res){
               Swal.close();
               if(res?.success){
                    Swal.fire({
                        icon: 'success',
                        title: '成功',
                        text: res.message,
                        confirmButtonText: '確定'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = appRoot + '/Account/ResetPassword?code=' + res.urlsafe;
                        }
                    });
               }
               else {
                   
                  showError(res.message);
               }
             },
               error: function () {
                    Swal.close();
                    showError("系統發生錯誤");
                }
           });
         });
         });

     function showAdminToast(message, type) {
      Swal.fire({
        toast: true,
        position: 'top-end',
        icon: type,
        title: message,
        showConfirmButton: false,
        timer: 2000
      });
    }
    // 成功提示
    function showSuccess(message) {
        Swal.fire({
            icon: 'success',
            title: '成功',
            text: message,
            timer: 2000,
            showConfirmButton: false
        });
    }

    // 錯誤提示
    function showError(message) {
        Swal.fire({
            icon: 'error',
            title: '錯誤',
            text: message,
            confirmButtonText: '關閉'
        });
    }

    function loadCaptcha() {
        const urlGenerate = '@Url.Content("~/Captcha/Generate")' + "?_=" + new Date().getTime();
        fetch(urlGenerate)
            .then(r => r.json())
            .then(data => {
                document.getElementById('captchaImage').src = data.imageUrl;
                document.getElementById('captchaToken').value = data.captchaToken;
                document.getElementById('captchaText').value = data.captchaText;
            })
            .catch(err => console.error("載入驗證碼錯誤：", err));
    }
    // 首次載入
    window.onload = loadCaptcha;
</script>