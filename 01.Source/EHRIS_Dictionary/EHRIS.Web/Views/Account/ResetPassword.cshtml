@model LoginViewModel
@using EHRIS.Core.Models.Common

@{
    ViewData["Title"] = "重設密碼";
    Layout = null;
}

<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>重設密碼</title>
    <!-- AdminLTE & Bootstrap -->
    <link rel="stylesheet" href="~/lib/admin-lte/css/adminlte.min.css">
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css">
    <!--jQuery-->
    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js" type="text/javascript" asp-append-version="true"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js" type="text/javascript" asp-append-version="true"></script>
    <script src="~/lib/jquery-ajax-unobtrusive-main/jquery.unobtrusive-ajax.js" type="text/javascript" asp-append-version="true"></script>
    <!-- Bootstrap 5 -->
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <!-- AdminLTE JS -->
    <script src="~/lib/admin-lte/js/adminlte.min.js"></script>

    <!-- SweetAlert2 CSS -->
    <link rel="stylesheet" href="~/lib/sweetalert2/sweetalert2.min.css" />

    <!-- SweetAlert2 JS -->
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
    <style>
        /*  body {

                background-size: cover;
                }

                .login-logo img {
                width: 100px;
                height: auto;
                }

                .card {
                backdrop-filter: blur(6px);
                background-color: rgba(255, 255, 255, 0.85);
                border-radius: 8px;
                } */
        /* 整個登入頁背景 */
        body.login-page {
            background-color: #a8b4be; /* 淺藍灰，比較柔和 */
            color: #2c3e50;
            font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
        }

        /* 登入框 */
        .login-box {
            width: 400px;
            margin: 5% auto;
        }

            .login-box .card {
                border-radius: 12px;
                border: none;
                box-shadow: 0 6px 16px rgba(0,0,0,0.15);
            }

            /* Card header */
            .login-box .card-header {
                background-color: #3a506b; /* 深藍灰 */
                color: #fff;
                border-radius: 12px 12px 0 0;
            }

            /* Card footer */
            .login-box .card-footer {
                background-color: #f8f9fa;
                border-top: 1px solid #dee2e6;
            }

            /* 輸入框 */
            .login-box .form-control {
                border-radius: 8px;
                border: 1px solid #7b8a97;
            }

                .login-box .form-control:focus {
                    border-color: #3a506b;
                    box-shadow: 0 0 6px rgba(58, 80, 107, 0.3);
                }

            /* 主按鈕 */
            .login-box .btn-primary {
                background-color: #3a506b;
                border-color: #3a506b;
            }

                .login-box .btn-primary:hover {
                    background-color: #2c3e50;
                    border-color: #2c3e50;
                }

            /* 忘記密碼連結 */
            .login-box a.btn-outline-primary {
                border-radius: 20px;
                color: #3a506b;
                border-color: #3a506b;
                font-size: 0.9rem;
            }

                .login-box a.btn-outline-primary:hover {
                    background-color: #3a506b;
                    color: #fff;
                }
    </style>
</head>
<body class="hold-transition login-page">

    <div class="login-box">
        <div class="login-logo">
            <b>@AppConfig.syi_title</b>
        </div>

        <div class="card card-outline card-primary shadow">
            <div class="card-header text-center">
                <h3 class="card-title">重設密碼</h3>
            </div>

            <div class="card-body">
                <form id="ResetPassword" method="post" >
                    @Html.AntiForgeryToken() <!--  防止 CSRF 攻擊 -->
                    <input type="hidden" name="VerifyCode" id="VerifyCode" value="@ViewBag.VerifyCode">
                 

                    <div class="input-group mb-3">
                        <div class="input-group  password-toggle">
                            <span class="input-group-text">
                                <i class="fas fa-lock"></i>
                            </span>
                            <input type="password" name="NewPassword" id="NewPassword" class="form-control" placeholder="新密碼" required />
                            <span class="input-group-text toggle-btn" style="cursor: pointer;">
                                <i class="fas fa-eye"></i>
                            </span>
                        </div>
                        <br /><span class="text-danger field-validation" data-valmsg-for="NewPassword"></span>
                    </div>

                    <div class="input-group mb-3">
                        <div class="input-group  ">
                            <span class="input-group-text">
                                <i class="fas fa-lock"></i>
                            </span>
                        <input type="password" name="ConfirmPassword" id="ConfirmPassword" class="form-control" placeholder="確認新密碼" required />
                        
                        </div>
                        <br /><span class="text-danger field-validation" data-valmsg-for="ConfirmPassword"></span>
                    </div>
                    <div class="input-group mb-3">
                        <div class="input-group  ">
                        <span class="input-group-text">
                            <i class="fas fa-shield-alt"></i>
                        </span>
                        <input type="text" name="VerificationCode" id="VerificationCode" class="form-control" placeholder="驗證碼 (6 位英數字)" required />
                      </div>
                        <br /><span class="text-danger field-validation" data-valmsg-for="VerificationCode"></span>
                    </div>
                    <div class="row">
                        <div class="col-8">
                            <span class="text-danger field-validation" data-valmsg-for="VerifyMessage"></span>
                        </div>
                        
                    </div>
                    <div class="row">
                        <div class="col-9">
                            <a href="@Url.Action("Login", "Account")" class="btn btn-sm btn-outline-primary">返回登入</a>
                        </div>
                        <div class="col-3">
                            <button type="submit" class="btn btn-primary btn-block">重設</button>
                        </div>
                    </div>
                    
                </form>
            </div>
            <div class="card-footer">
                <div class="row">
                    
                        <span>@ViewBag.Notice</span>
                   

                </div>
            </div>
        </div>
    </div>

 
</body>
</html>
<script>

    $(function () {
         //密碼眼睛
         $(".password-toggle .toggle-btn").on("click", function () {
            let $wrapper = $(this).closest(".password-toggle");
            let $input = $wrapper.find("input");
            let $icon = $(this).find("i");

            if ($input.attr("type") === "password") {
                $input.attr("type", "text");
                $icon.removeClass("fa-eye").addClass("fa-eye-slash");
            } else {
                $input.attr("type", "password");
                $icon.removeClass("fa-eye-slash").addClass("fa-eye");
            }
        });

     $('#ResetPassword').on('submit', function (e) {
        e.preventDefault();

           let isValid = true;

           //檢查必填
           if ($('#NewPassword').val().trim() === '') {
               $('[data-valmsg-for="NewPassword"]').text('新密碼必填');
               isValid = false;
           }
           if ($('#ConfirmPassword').val().trim() === '') {
               $('[data-valmsg-for="ConfirmPassword"]').text('確認新密碼必填');
               isValid = false;
           }
           if ($('#VerificationCode').val().trim() === '') {
               $('[data-valmsg-for="VerificationCode"]').text('驗證碼必填');
               isValid = false;
           }

         
           const body = {
              verifydata: $('#VerifyCode').val(),
              verificationCode: $('#VerificationCode').val(),
              newPassword: $('#NewPassword').val(),
              confirmPassword: $('#ConfirmPassword').val()
            };

           // 如果不合法就不送出
           if (!isValid) return;

           // 顯示處理中
           Swal.fire({
               title: '處理中...',
               allowOutsideClick: false,
               didOpen: () => {
                   Swal.showLoading(); // 轉圈動畫
               }
           });
           let token = $('input[name="__RequestVerificationToken"]').val();
           const url =  '/Account/ResetPassword' ;
           var appRoot = '@Url.Content("~")';
           $.ajax({
             url: appRoot + url,
             type: 'POST',
             contentType: 'application/json',
             headers: {
                'RequestVerificationToken': token
            },
             data: JSON.stringify(body),
             success: function(res){
                  Swal.close();
               if(res?.success){

                   // showAdminToast(res.message, 'success');
                   // showSuccess(res.message);
                   Swal.fire({
                        icon: 'success',
                        title: '成功',
                        text: res.message,
                        confirmButtonText: '確定'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = appRoot + '/Account/Login';
                        }
                    });
               }
               else {
                    $('[data-valmsg-for="VerifyMessage"]').text(res.message);
                   showAdminToast(res.message, 'error');
                   showError(res.message);

               }
             },
               error: function () {
                  Swal.close();
                  showAdminToast('系統發生錯誤', 'error');
                }
           });
         });
         });

     function showAdminToast(message, type) {
      Swal.fire({
        toast: true,
        position: 'top-end',
        icon: type,
        title: message,
        showConfirmButton: false,
        timer: 2000
      });
    }
    // 成功提示
    function showSuccess(message) {
        Swal.fire({
            icon: 'success',
            title: '成功',
            text: message,
            timer: 2000,
            showConfirmButton: false
        });
    }

    // 錯誤提示
    function showError(message) {
        Swal.fire({
            icon: 'error',
            title: '錯誤',
            text: message,
            confirmButtonText: '關閉'
        });
    }
</script>
