@model EHRIS.Web.Shared.Models.PeoplePhotoModel

@{
    var cid = Model.ComponentId;
    var fieldName = Model.FieldName;
    var wmFieldName = Model.WatermarkFieldName;
    var watermarkText = Model.WatermarkText ?? "";
    var existingFile = Model.ExistingFileName ?? "";
    var existingWmFile = Model.ExistingWatermarkFileName ?? "";
    var allowedExt = Model.AllowedExtensions;
    var acceptAttr = string.Join(",", allowedExt.Select(e => "." + e));
    var extDisplay = string.Join(", ", allowedExt.Select(e => e.ToUpper()));
    var extJson = "[" + string.Join(",", allowedExt.Select(e => "'." + e + "'")) + "]";
}

<div id="@cid" class="people-photo-component">
    <!-- hidden inputs -->
    <input type="hidden" id="@(cid)_fileName" name="@fieldName" value="@existingFile" />
    <input type="hidden" id="@(cid)_wmFileName" name="@wmFieldName" value="@existingWmFile" />

    <div class="row">
        <!-- 左側：照片預覽 -->
        <div class="col-auto">
            <div id="@(cid)_previewBox" style="width:132px; height:170px; border:1px solid #ccc; display:flex; align-items:center; justify-content:center; background:#f8f8f8;">
                <img id="@(cid)_preview" src="" alt="照片預覽" style="max-width:100%; max-height:100%; display:none; cursor:pointer;" title="點擊放大" />
                <span id="@(cid)_placeholder" class="text-muted small">尚無照片</span>
            </div>
        </div>

        <!-- 右側：操作區 -->
        <div class="col">
            <div class="d-flex align-items-center gap-2 mb-2">
                <input type="file" id="@(cid)_input" accept="@acceptAttr"
                       class="form-control form-control-sm" style="max-width:300px;" />
                <button type="button" id="@(cid)_uploadBtn" class="btn btn-sm btn-primary">
                    <i class="fas fa-upload"></i> 上傳
                </button>
            </div>
            <div id="@(cid)_msg" class="text-danger small mb-2"></div>
            <small class="text-danger fw-bold">
                註：僅限 @extDisplay 格式，解析度寬 &ge; @(Model.MinWidth)px、高 &ge; @(Model.MinHeight)px。
            </small>
        </div>
    </div>

    <!-- 裁切 Modal -->
    <div class="modal " id="@(cid)_cropModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h5 class="modal-title">
                        <i class="fas fa-crop-alt me-1"></i> 調整裁切範圍
                    </h5>
                    <small class="text-muted ms-2">拖曳框選人頭位置，比例固定 3:4</small>
                </div>
                <div class="modal-body p-2">
                    <div id="@(cid)_cropContainer" style="max-height:500px;">
                        <img id="@(cid)_cropImg" src="" style="max-width:100%;" />
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" id="@(cid)_cancelBtn" class="btn btn-sm btn-secondary">
                        <i class="fas fa-times"></i> 取消
                    </button>
                    <button type="button" id="@(cid)_confirmBtn" class="btn btn-sm btn-success">
                        <i class="fas fa-check"></i> 確認裁切
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- 放大預覽 Modal -->
    <div class="modal " id="@(cid)_zoomModal" tabindex="-1">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body p-1 text-center">
                    <img id="@(cid)_zoomImg" src="" style="max-width:100%; cursor:pointer;" />
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="@Url.Content("~/lib/cropperjs/cropper.min.css")" />
<script src="@Url.Content("~/lib/cropperjs/cropper.min.js")"></script>
<script src="@Url.Content("~/js/Common/PeoplePhoto.js")"></script>
<script>
    window.PeoplePhoto.init({
        cid: '@cid',
        baseUrl: '@Url.Content("~/")'.replace(/\/+$/, ''),
        watermarkText: '@Html.Raw(watermarkText)',
        existingFile: '@Html.Raw(existingFile)',
        existingWmFile: '@Html.Raw(existingWmFile)',
        allowedExtensions: @Html.Raw(extJson)
    });
</script>
